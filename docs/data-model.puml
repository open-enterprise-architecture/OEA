' ╔══════════════════════════════════════════════════════╗
' ║  AUDIT (Schema: audit.*) (ADR-024, ADR-033)         ║
' ╚══════════════════════════════════════════════════════╝
package "Audit  [Schema: audit]" #EFEBE9 {

  class "audit.events" <<Table>> #D7CCC8 {
    + id             : BIGSERIAL          {PK}
    .. technical key; the chain order is chain_seq ..
    --
    + event_type     : TEXT               {NN}
    .. stable name from the event catalog (ADR-033 §8), e.g. 'entity.created', ..
    .. 'auth.login', 'authz.denied', 'settings.audit-retention-changed', ..
    .. 'analytics.query.executed', 'audit.checkpoint' ..
    + event_category : TEXT               {NN}
    .. enum: change | security | access | system ..
    + severity       : TEXT               {NN}
    .. enum: info | warning | high | critical ..
    + outcome        : TEXT               {NN}
    .. enum: success | failure | denied ..
    + occurred_at    : TIMESTAMPTZ        {NN} DEFAULT NOW()
    + source         : TEXT               {NN}
    .. enum: UI | API | Job | Import ..
    + source_ip      : INET
    + request_id     : TEXT
    .. HTTP correlation ID or job run ID ..
    == Actor (pseudonymous, ADR-033 §3) ==
    + actor_type     : TEXT               {NN}
    .. enum: person | service-account | system-admin-account | system | unauthenticated ..
    + actor_person_id : BIGINT
    .. soft ref → persons.id (no FK; audit DB can be external) ..
    + actor_admin_id : UUID
    .. soft ref → system_admin_accounts.id ..
    .. CHECK: actor_type IN (person, service-account) ⇔ actor_person_id NOT NULL ..
    .. CHECK: actor_type = system-admin-account ⇔ actor_admin_id NOT NULL ..
    .. CHECK: at most one of the pair set; both NULL for system | unauthenticated ..
    .. no actor names or e-mail addresses in the audit schema ..
    == Target ==
    + target_type    : TEXT
    .. e.g. entity | person | role | role-assignment | setting | service-account ..
    + target_id      : TEXT
    + entity_id      : INTEGER
    .. soft ref → entities.id ..
    + entity_name    : TEXT
    .. denormalized for completeness (not evidence); NULL for metatype 'person' ..
    .. (names of modeled persons are not copied, owner confirmation 2026-10-13) ..
    + details        : JSONB
    .. event-type-specific supplement (e.g. role, validity, sodConflict, ..
    .. analytics queryHash/queryFingerprint/referencedViews/metrics); ..
    .. fields needed for regulatory queries are columns, not payload ..
    == External integration (ADR-026, ADR-033 §7) ==
    + agent_id       : TEXT
    .. client_id (UUID text) of the authenticated service account ONLY; ..
    .. NULL for humans and the system admin account ..
    + agent_label    : TEXT
    .. untrusted X-Agent-Id header; CHECK char_length(agent_label) <= 100; ..
    .. control characters removed; never used for decisions ..
    + agent_run      : TEXT
    .. correlation ID of a run (X-Agent-Run); informational ..
    == Hash chain (mandatory, all editions; ADR-033 §5) ==
    + chain_seq      : BIGINT             {NN} {UQ}
    + hash_version   : SMALLINT           {NN}
    + prev_hash      : BYTEA              {NN}
    .. 32 bytes; genesis = 32 zero bytes ..
    + record_hash    : BYTEA              {NN}
    .. 32 bytes; SHA-256 over canonical serialization (docs/audit-hash-chain.md) ..
  }

  class "audit.event_changes" <<Table>> #D7CCC8 {
    + id               : BIGSERIAL        {PK}
    --
    + event_id         : BIGINT           {NN} {FK→audit.events.id}
    + property_def_id  : UUID
    .. soft ref → property_definitions.id; visibility evaluated on the definition ..
    + property_name    : TEXT             {NN}
    .. denormalized ('name', 'lifecycle', 'version', …) ..
    + system_field     : BOOLEAN          {NN} DEFAULT false
    .. true = system field; false = user-defined property ..
    == Values (REQ-160 AC4) ==
    + value_protection : TEXT             {NN} DEFAULT 'plain'
    .. enum: plain | encrypted ..
    .. encrypted iff visibility_mode <> 'public' at the time of the event ..
    + old_value        : TEXT
    .. plaintext, serialized as text ..
    + new_value        : TEXT
    + old_value_enc    : BYTEA
    .. AES-256-GCM ciphertext ..
    + new_value_enc    : BYTEA
    + key_id           : TEXT
    .. audit value key (wrapped by the KEK of REQ-188) ..
    .. CHECK: value_protection = 'encrypted' ⇒ old_value IS NULL AND ..
    .. new_value IS NULL AND key_id IS NOT NULL; ..
    .. value_protection = 'plain' ⇒ *_enc IS NULL AND key_id IS NULL ..
    == Hash chain ==
    + chain_seq        : BIGINT           {NN} {UQ}
    + hash_version     : SMALLINT         {NN}
    + prev_hash        : BYTEA            {NN}
    + record_hash      : BYTEA            {NN}
  }

  class "audit.retention_settings" <<Table>> #D7CCC8 {
    + id                  : BIGSERIAL     {PK}
    --
    + retention_days      : INTEGER       {NN}
    .. CHECK (retention_days >= 365); floor not configurable (Q10) ..
    .. seeded by the first audit migration with 2555 (7 years) ..
    + recorded_at         : TIMESTAMPTZ   {NN} DEFAULT NOW()
    + effective_from      : TIMESTAMPTZ   {NN}
    .. = recorded_at + 30 days if lower than the value in force, ..
    .. otherwise = recorded_at ..
    + recorded_by_person_id : BIGINT
    .. soft ref → persons.id ..
    + recorded_by_admin_id  : UUID
    .. soft ref → system_admin_accounts.id ..
    .. CHECK: at most one set; both NULL = migration seed ..
    == Hash chain ==
    + chain_seq           : BIGINT        {NN} {UQ}
    + hash_version        : SMALLINT      {NN}
    + prev_hash           : BYTEA         {NN}
    + record_hash         : BYTEA         {NN}
  }

  note right of "audit.retention_settings"
    Append-only series; value in force = latest row
    with effective_from <= now. Only principals with
    settings:manage add rows (dedicated operation;
    replaces SystemSettings.auditRetentionDays).
    An owner-defined trigger appends
    'settings.audit-retention-changed' (old, new,
    effective date, actor) in the same transaction.
  end note

  class "audit.chain_head" <<Table>> #D7CCC8 {
    + id          : SMALLINT              {PK}
    .. CHECK (id = 1): single row ..
    --
    + last_seq    : BIGINT                {NN}
    + last_hash   : BYTEA                 {NN}
    + updated_at  : TIMESTAMPTZ           {NN}
  }

  note right of "audit.chain_head"
    Owner only; NO grants to oea_app.
    Maintained by the BEFORE INSERT trigger
    (SECURITY DEFINER, owner oea_owner) on all three
    chain tables: locks the row, assigns chain_seq,
    sets prev_hash, computes record_hash; values
    supplied by the application are overwritten.
    One chain across events, event_changes and
    retention_settings (ADR-033 §5).
  end note

  class "audit.purge_expired()" <<Function>> #EFEBE9 {
    SECURITY DEFINER; owner oea_owner; fixed search_path
    --
    deletes the oldest contiguous chain range older than
    GREATEST(retention in force, 365) days, in batches;
    appends 'audit.retention-purged' (first/last chain_seq,
    count, retention, record_hash of the last deleted link)
    EXECUTE: oea_audit_cleanup only
  }

  note right of "audit.events"
    ADR-033 (replaces the ADR-024 note), DM-A8:
    Owner of schema and all objects: oea_owner.
    oea_app: INSERT + SELECT on events, event_changes,
    retention_settings only (USAGE on sequences);
    no UPDATE/DELETE/TRUNCATE/REFERENCES/TRIGGER;
    no rights on chain_head.
    oea_audit_cleanup: EXECUTE audit.purge_expired() only.
    oea_auditor: SELECT on all audit tables.
    oea_analytics / reporting roles: no access.
    Retention floor 1 year (DB CHECK + function),
    default 7 years (2555 days); reductions take
    effect after 30 days. No API/UI operation
    modifies or deletes audit records.
    Hash chain mandatory in all editions
    (flag oea.audit.hash-chain-enabled removed);
    checkpoints ('audit.checkpoint') exported to the
    application log and the SIEM export (§6).
    Migrations: db/migration-audit, history table
    audit.flyway_schema_history; additive only.
    Optional external DB: oea.datasource.audit.url.
    Event types of ADR-034 (DM-4):
    'analytics.query.executed' | 'analytics.query.rejected'
    with details: queryHash (SHA-256), queryFingerprint
    (literal-free), referencedViews[], analyticsOutcome
    (ok | truncated-rows | truncated-size | timeout |
    rejected-<rule> | rate-limited | execution-error),
    durationMs, rowCount, resultBytes, sessionId.
    Never result content or bound parameter values.
    Unauthenticated events: attempted login identifier
    only as keyed HMAC-SHA-256 in details.
  end note

  "audit.events" "1" --o{ "0..*" "audit.event_changes" : details

}

