# OEA operator configuration for compose.yaml (ADR-036 §3, §8).
# Copy to .env and fill in EVERY value. Never commit .env.
# Use long random values (at least 16 characters); development values are rejected.

# PostgreSQL superuser, used only by the provisioning script on the first start
POSTGRES_PASSWORD=

# Database role passwords (ADR-037, manual/setup/installation.md)
OEA_OWNER_PASSWORD=
OEA_REPORTING_OWNER_PASSWORD=
OEA_APP_PASSWORD=
OEA_AUDIT_CLEANUP_PASSWORD=
OEA_AUDITOR_PASSWORD=
OEA_ANALYTICS_PASSWORD=

# Key-encryption key file for stored secrets (REQ-188): Base64 of 32 random bytes, e.g.
#   head -c 32 /dev/urandom | base64 > /secure/path/oea-kek.key && chmod 0444 /secure/path/oea-kek.key
# Keep it outside the database backups.
OEA_KEK_FILE=

# Optional (not secrets): backend image and published HTTP address
# OEA_BACKEND_IMAGE=oea-backend:local
# OEA_HTTP_BIND=127.0.0.1
# OEA_HTTP_PORT=8080
