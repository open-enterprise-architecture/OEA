    "generate:screenshots": "node scripts/screenshots.mjs",
    "walkthrough": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^25.9.9",
    "typescript": "~6.0.2",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  }
