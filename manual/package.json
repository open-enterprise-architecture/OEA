{
  "name": "oea-manual",
  "private": true,
  "version": "0.0.1",
  "description": "OEA user manual (VitePress, English and German; ADR-045)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:api": "node scripts/generate-api-reference.mjs",
    "predev": "npm run generate:api && npm run generate:screenshots",
