<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root aggregator (ADR-041). Its only purpose is that tools working on the repository
  root - in particular GitHub's automatic dependency submission - see the backend module.
  It declares no dependencies and no plugins; builds keep running in backend/ (ADR-027).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.oea</groupId>
	<artifactId>oea-aggregator</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>OEA</name>
	<description>Aggregator of the OEA Maven modules (ADR-041)</description>
	<licenses>
		<license>
			<name>GNU Affero General Public License v3.0</name>
			<url>https://www.gnu.org/licenses/agpl-3.0.html</url>
		</license>
	</licenses>
	<modules>
		<module>backend</module>
	</modules>
</project>
